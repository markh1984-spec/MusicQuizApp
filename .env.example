# Copy this file to ".env" and fill in the bits you have.
#
#   cp .env.example .env
#
# The app reads it automatically when you run npm start, npm run generate:quiz
# and so on. You do not need any of these to run a quiz — they are only for
# the AI generation and the Spotify playlists.
#
# .env is in .gitignore, so it never gets committed. Keep it that way: these
# are passwords.
#
# On your host (Render) you do NOT use this file — you paste the same
# name/value pairs into the dashboard under Environment.


# The password for your control view, console and editor.
# Leave it out and the app invents one and prints it on startup.
HOST_KEY=change-me-to-something-you-can-type-in-the-dark


# --- AI generation -----------------------------------------------------
# Writes quizzes and picks bingo tracks. From console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...


# --- Round 2 portraits -------------------------------------------------
# Draws the "whose face is this?" pictures. From platform.openai.com.
# Anthropic has no image API, so this has to be a separate account.
# OPENAI_API_KEY=sk-...


# --- Spotify playlists -------------------------------------------------
# Builds the playlist your DJ app plays a bingo round from.
# Run `npm run spotify:login` and it prints all three of these for you.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
