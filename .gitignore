node_modules/

# Live game state and the generated host key — machine-specific, and the state
# file is rewritten constantly during a gig.
data/*

# ...but the song history IS worth keeping. It is what stops the generator
# repeating songs between gigs, and on a host that wipes its filesystem on
# every deploy (Render's free tier does) committing it is the only way it
# survives. Generate packs at home, commit this file, push.
!data/track-history.json

# NOTE: images/ is deliberately NOT ignored. Your host builds from git, so any
# picture that is not committed does not exist on the deployed app and round 2
# comes up blank. Commit your artwork.

# NOTE: adverts/ is deliberately NOT ignored. A venue's slides are worth having
# again next week, and the live app builds from git — an advert set that is not
# committed does not exist on the deployed app.

# Screenshots from scripts/shots.mjs
screenshots/

.DS_Store
*.log
.env

# Impeccable's own working files (cache, session state) — not the skill
# itself, which lives in .claude/skills/impeccable/ and IS committed.
/.impeccable/

# Isolated worktrees the Agent tool creates for parallel/mutating sub-agents.
# Transient scaffolding, auto-removed once the agent finishes.
.claude/worktrees/

# Throwaway browser-driving scripts. The guards in scripts/ are committed and
# named plainly; anything measuring something once is written to the repo root
# as *.tmp.mjs, because a Playwright script has to sit beside
# scripts/helpers/live-app.mjs to import it. They are deleted when the run
# finishes — but a run that is still going, or one that was killed, leaves the
# file behind, and then the only two ways out are committing scratch into the
# repository or deleting a file something is still executing. Neither is a
# choice anybody should have to make: name the pattern instead.
*.tmp.mjs
