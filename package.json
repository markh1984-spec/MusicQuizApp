{
  "name": "musicquizapp",
  "version": "1.0.0",
  "private": true,
  "description": "Live interactive music quiz for pubs and clubs. Big screen, player phones, host control.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test test/*.test.js",
    "screenshots": "node scripts/shots.mjs",
    "generate:quiz": "node --env-file-if-exists=.env scripts/generate-quiz.mjs",
    "generate:images": "node --env-file-if-exists=.env scripts/generate-images.mjs",
    "spotify:login": "node --env-file-if-exists=.env scripts/spotify-login.mjs",
    "accounts": "node scripts/accounts.mjs"
  },
  "dependencies": {}
}
